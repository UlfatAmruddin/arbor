<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for ad-hoc signed releases (scripts/sign-and-notarize.sh without a Developer ID, DEC-027).
  The same as Arbor.entitlements plus one hardened-runtime exception:

  - com.apple.security.cs.disable-library-validation: library validation only loads frameworks signed by
    Apple or by the app's own Team ID, and an ad-hoc signature has no Team ID, so the hardened runtime
    would refuse to load the embedded Sparkle.framework (in-app updates, FE-259, DEC-028). DYLD_*
    variables stay blocked. A Developer ID release signs Sparkle with the same Team ID and uses
    Arbor.entitlements, without this exception.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
